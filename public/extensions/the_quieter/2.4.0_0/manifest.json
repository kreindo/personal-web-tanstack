      "matches": [ "https://www.youtube.com/*" ],
      "resources": [ "icons/icon-16.png", "icons/icon-48.png", "icons/icon-128.png", "icons/toggle.png", "_locales/en/messages.json", "_locales/ar/messages.json", "_locales/ur/messages.json", "_locales/bn/messages.json", "_locales/hi/messages.json", "_locales/tr/messages.json", "_locales/id/messages.json" ]
   } ]
